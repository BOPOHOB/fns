[Unit]
Description=feelAndSwim (Deno API + SSR)
After=network.target

[Service]
Type=simple
User=bopohob
WorkingDirectory=/opt/feelandswim
ExecStart=/usr/local/bin/deno run -A --env-file=/opt/feelandswim/.env /opt/feelandswim/src/backend/main.ts
Restart=on-failure
RestartSec=3
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=PROJECT_ROOT=/opt/feelandswim
Environment=DB_PATH=/opt/feelandswim/data.db
Environment=FRONTEND_ORIGIN=https://feelandswim.ru
Environment=OAUTH_REDIRECT_URI=https://feelandswim.ru/auth/callback
Environment=COOKIE_SECURE=true

[Install]
WantedBy=multi-user.target
