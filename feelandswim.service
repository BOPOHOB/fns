[Unit]
Description=feelAndSwim API (Deno)
After=network.target

[Service]
Type=simple
User=bopohob
WorkingDirectory=/var/www/feelandswim
ExecStart=/home/bopohob/.deno/bin/deno run -A --env-file=/var/www/feelandswim/.env /var/www/feelandswim/src/backend/main.ts
Restart=on-failure
RestartSec=3
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=DB_PATH=/var/www/feelandswim/data.db
Environment=FRONTEND_ORIGIN=https://feelandswim.ru
Environment=OAUTH_REDIRECT_URI=https://feelandswim.ru/auth/callback
Environment=COOKIE_SECURE=true

[Install]
WantedBy=multi-user.target
