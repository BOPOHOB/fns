{
  "name": "feelandswim-backend",
  "imports": {
    "hono": "jsr:@hono/hono@^4.11.4",
    "@types/": "./src/types/",
    "@shared/": "./src/shared/",
    "@resvg/resvg-wasm": "npm:@resvg/resvg-wasm@2.6.2"
  },
  "nodeModulesDir": "auto",
  "exports": "./src/backend/main.ts",
  "tasks": {
    "backend": "DENO_ENV=development deno run -A src/backend/main.ts",
    "backend:dev": "DENO_ENV=development deno run -A --env-file=.env --watch src/backend/main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.ns"]
  }
}
